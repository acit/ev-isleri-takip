{
  "rules": {
    "aile_grubu": {
      "$gid": {
        "meta": {
          ".read": "auth != null && root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists()",

          "ownerUid": {
            ".write": "auth != null && !data.exists()"
          },
          "passcodeHash": {
            ".write": "auth != null && (root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists() || !data.exists())"
          },
          "createdAt": {
            ".write": "auth != null && !data.exists()"
          },

          "members": {
            "$uid": {
              ".read": "auth != null && ($uid === auth.uid || root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists())",

              ".write": "auth != null && (root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists() || ($uid === auth.uid && !root.child('aile_grubu').child($gid).child('meta').child('members').exists()))",

              ".validate": "newData.hasChild('name')"
            }
          },

          "tombstones": {
            ".read": "auth != null && root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists()",
            "$table": {
              ".write": "auth != null && root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists()",
              "$recordId": {
                ".write": "auth != null && root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists()",
                ".validate": "newData.hasChild('deletedAt')"
              }
            }
          }
        },

        "joins": {
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists())",

            ".write": "auth != null && ($uid === auth.uid || root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists())",

            ".validate": "newData.hasChild('name') && newData.hasChild('status')"
          }
        },

        "members": {
          ".read": "auth != null && root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('aile_grubu').child($gid).child('meta').child('members').child(auth.uid).exists()"
        },
