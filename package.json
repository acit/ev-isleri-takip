{
  "name": "aile-takip-sistemi",
  "version": "2.0.0",
  "description": "Modern aile yönetimi ve organizasyon platformu",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint"
  },
  "keywords": [
    "aile",
    "family",
    "management",
    "tasks",
    "inventory",
    "budget",
    "shopping",
    "messaging",
    "react",
    "nodejs",
    "typescript"
  ],
  "author": "Erhan Koksal <erhan.koksal@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erhankoksal/aile-takip-sistemi.git"
  },
  "bugs": {
    "url": "https://github.com/erhankoksal/aile-takip-sistemi/issues"
  },
  "homepage": "https://github.com/erhankoksal/aile-takip-sistemi#readme",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}